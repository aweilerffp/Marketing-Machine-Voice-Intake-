# Anthropic API key for extraction pipeline, nugget detection, and the
# Gemini rollover handoff brief
ANTHROPIC_API_KEY=sk-ant-...

# Voice provider for the live interview: gemini | elevenlabs | mock
# (mock replays public/transcripts/test-*.txt with no audio)
NEXT_PUBLIC_VOICE_PROVIDER=gemini

# --- Gemini Live (NEXT_PUBLIC_VOICE_PROVIDER=gemini) ---
# Server-only. Get a key at https://aistudio.google.com/ (free tier is fine for
# development; use a paid-project key for real client sessions, since free-tier
# content may be used to improve Google's models).
GEMINI_API_KEY=
# Live model. Preview ids rotate; 3.1 replies ~3x faster than the 2.5 native-audio model.
# Fallback: gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Prebuilt voice name
# GEMINI_VOICE=Kore
# Server VAD: how long the founder must pause before the turn ends (ms)
# GEMINI_VAD_SILENCE_MS=1100
# Safety timer for the ~10 minute connection clock (minutes since connect)
# NEXT_PUBLIC_GEMINI_ROLLOVER_MINUTES=9
# Dev only: always take the Claude handoff path instead of resumption
# NEXT_PUBLIC_GEMINI_FORCE_HANDOFF=true
# Dev only: log every Live server message type to the console
# NEXT_PUBLIC_GEMINI_DEBUG=true

# --- ElevenLabs (legacy, NEXT_PUBLIC_VOICE_PROVIDER=elevenlabs) ---
# NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_...
